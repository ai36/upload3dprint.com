---
// plan §2.3 payments stub (T025): stands in for Stripe Checkout until the account exists.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Test payment | upload3dprint</title>
  </head>
  <body>
    <main>
      <h1>Test payment</h1>
      <p>This page stands in for the card payment page. No money is charged.</p>
      <p>Order <strong id="order"></strong>, total <strong id="total"></strong></p>
      <div class="buttons">
        <button id="pay" class="primary" type="button">Pay</button>
        <button id="decline" type="button">Decline</button>
      </div>
      <p id="message" role="status" aria-live="polite"></p>
      <p><a href="/">Back to the quote</a></p>
    </main>
    <script>
      import { clearDraft } from '../savedDraft.ts';
      const API = import.meta.env.PUBLIC_API_URL ?? '';
      const q = new URLSearchParams(location.search);
      const $ = (id: string) => document.getElementById(id)!;
      $('order').textContent = q.get('order') ?? '—';
      $('total').textContent = '$' + (Number(q.get('total')) / 100).toFixed(2);

      async function send(type: 'paid' | 'declined') {
        for (const b of document.querySelectorAll('button')) b.disabled = true;
        const r = await fetch(API + '/api/payment-webhook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, session_id: q.get('session') }),
        });
        const body = await r.json().catch(() => ({}));
        if (!r.ok) {
          $('message').textContent = body.error ?? 'Something went wrong.';
          return;
        }
        if (type === 'declined') return location.assign('/?restore=1');
        await clearDraft().catch(() => {});
        $('message').textContent = `Payment received. Order ${body.order} is confirmed, and the details are on the way to your e-mail.`;
      }
      $('pay').addEventListener('click', () => send('paid'));
      $('decline').addEventListener('click', () => send('declined'));
    </script>
    <style is:global>
      body { margin: 0; font: 16px/1.5 system-ui, sans-serif; color: #1d232a; background: #f7f8fa; }
      main { max-width: 560px; margin: 0 auto; padding: 16px; }
      .buttons { display: flex; gap: 12px; }
      button { font: inherit; padding: 10px 18px; border-radius: 8px; border: 1px solid #9aa5b1; background: #fff; cursor: pointer; }
      button.primary { background: #2f6fb0; border-color: #2f6fb0; color: #fff; font-weight: 600; }
      button:disabled { opacity: 0.6; }
    </style>
  </body>
</html>
